{
  "opencollection": "1.0.0",
  "info": {
    "name": "Ask Sage Server Admin User Information API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-access-tokens",
      "value": "{{x-access-tokens}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "User Information",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get user activity logs",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{baseUrl}/server/get-user-logs"
          },
          "docs": "Get user activity logs"
        },
        {
          "info": {
            "name": "Get user login history",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{baseUrl}/server/get-user-logins",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Get user login history"
        }
      ]
    }
  ],
  "bundled": true
}