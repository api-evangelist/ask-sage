{
  "opencollection": "1.0.0",
  "info": {
    "name": "Ask Sage Server Admin System API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-access-tokens",
      "value": "{{x-access-tokens}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "System",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Debug endpoint to view request headers",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{baseUrl}/server/get-headers"
          },
          "docs": "Debug endpoint to view request headers"
        }
      ]
    }
  ],
  "bundled": true
}