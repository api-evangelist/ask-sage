{
  "opencollection": "1.0.0",
  "info": {
    "name": "Ask Sage Server Admin User Management API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-access-tokens",
      "value": "{{x-access-tokens}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "User Management",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Register new user",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{baseUrl}/server/register",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Register new user"
        },
        {
          "info": {
            "name": "Update user profile",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{baseUrl}/server/update",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update user profile"
        },
        {
          "info": {
            "name": "Verify email address",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{baseUrl}/server/verify-email",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Verify email address"
        },
        {
          "info": {
            "name": "Request password reset",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{baseUrl}/server/lost-pass",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Request password reset"
        },
        {
          "info": {
            "name": "Enable or update MFA",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{baseUrl}/server/update-mfa",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Enable or update MFA"
        },
        {
          "info": {
            "name": "Logout user",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{baseUrl}/server/logout"
          },
          "docs": "Logout user"
        }
      ]
    }
  ],
  "bundled": true
}