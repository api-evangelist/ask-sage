{
  "opencollection": "1.0.0",
  "info": {
    "name": "Ask Sage Server Admin Widgets API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-access-tokens",
      "value": "{{x-access-tokens}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Widgets",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Add widget",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{baseUrl}/server/add-widget",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Add widget"
        },
        {
          "info": {
            "name": "Update widget",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "{baseUrl}/server/update-widget",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update widget"
        },
        {
          "info": {
            "name": "List widgets",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{baseUrl}/server/list-widgets"
          },
          "docs": "List widgets"
        },
        {
          "info": {
            "name": "List widgets (POST)",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{baseUrl}/server/list-widgets"
          },
          "docs": "List widgets (POST)"
        },
        {
          "info": {
            "name": "Delete widget",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{baseUrl}/server/delete-widget",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Delete widget"
        }
      ]
    }
  ],
  "bundled": true
}